{
  "name": "@internal/plugin-daas-common",
  "version": "0.1.0",
  "description": "Shared types, API client, schema-to-form conversion and permissions for the DAAS plugins",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "common-library",
    "pluginId": "daas",
    "pluginPackages": [
      "@internal/plugin-daas",
      "@internal/plugin-daas-backend",
      "@internal/plugin-daas-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fixtures.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "src/testing/fixtures.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  }
}

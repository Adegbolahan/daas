{
  "name": "@internal/plugin-daas",
  "version": "0.1.0",
  "description": "DAAS UI for Backstage: platform overview, teams, apps and deployments, secrets, and schema-driven create/update templates",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "daas",
    "pluginPackages": [
      "@internal/plugin-daas",
      "@internal/plugin-daas-backend",
      "@internal/plugin-daas-common"
    ]
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/plugin-scaffolder-react": "^2.1.0",
    "@backstage/ui": "^0.18.0",
    "@internal/plugin-daas-common": "^0.1.0",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/frontend-defaults": "^0.5.6",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@backstage/plugin-app-react": "^0.2.7",
    "@backstage/plugin-catalog": "^2.0.9",
    "@backstage/plugin-permission-react": "^0.5.5",
    "@backstage/plugin-scaffolder": "^1.39.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/zen-observable": "^0.8.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2",
    "zen-observable": "^0.10.0"
  },
  "files": [
    "dist"
  ]

#!/usr/bin/env bash
# Manage DAAS secrets with your Entra ID login. Values are read from stdin, never from arguments,
# so they don't land in shell history.
#
#   daas-secret set    <stage> <team> <app> <NAME> [gcp|aws]   < value
#   daas-secret list   <stage> <team> <app>
#   daas-secret delete <stage> <team> <app> <NAME> [gcp|aws]
#
#   echo -n 'postgres://...' | daas-secret set production payments payments-api DB_URL
#
# Env: DAAS_API (default https://daas.example.com), DAAS_SCOPE (default api://daas/.default)
set -euo pipefail
API="${DAAS_API:-https://daas.example.com}"
SCOPE="${DAAS_SCOPE:-api://daas/.default}"
cmd="${1:-}"; shift || true

token() { az account get-access-token --scope "$SCOPE" --query accessToken -o tsv; }
q() { [ -n "${1:-}" ] && echo "?provider=$1" || true; }

case "$cmd" in
  set)
    [ $# -ge 4 ] || { echo "usage: daas-secret set <stage> <team> <app> <NAME> [gcp|aws] < value" >&2; exit 2; }
    value="$(cat)"
    [ -n "$value" ] || { echo "empty value on stdin" >&2; exit 2; }
    body=$(jq -n --arg v "$value" --arg p "${5:-}" '{value: $v} + (if $p == "" then {} else {provider: $p} end)')
    curl -sS --fail-with-body -X PUT "$API/v1/secrets/$1/$2/$3/$4" \
      -H "Authorization: Bearer $(token)" -H "Content-Type: application/json" --data "$body" | jq . ;;
  list)
    [ $# -eq 3 ] || { echo "usage: daas-secret list <stage> <team> <app>" >&2; exit 2; }
    curl -sS --fail-with-body "$API/v1/secrets/$1/$2/$3" -H "Authorization: Bearer $(token)" \
      | jq -r '.secrets[] | "\(.name)\t\(.provider)\t\(.updated // "")"' ;;
  delete)
    [ $# -ge 4 ] || { echo "usage: daas-secret delete <stage> <team> <app> <NAME> [gcp|aws]" >&2; exit 2; }
    curl -sS --fail-with-body -X DELETE "$API/v1/secrets/$1/$2/$3/$4$(q "${5:-}")" \
      -H "Authorization: Bearer $(token)" | jq . ;;
  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
